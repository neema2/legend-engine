AWS_CREDENTIALS:                        'awsCredentials';
DEFAULT:                                'Default';
STATIC:                                 'Static';
STS_ASSUME_ROLE:                        'STSAssumeRole';
ACCESS_KEY_ID:                          'accessKeyId';
SECRET_ACCESS_KEY:                      'secretAccessKey';
ROLE_ARN:                               'roleArn';
